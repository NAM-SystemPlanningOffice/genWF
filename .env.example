# 環境変数のサンプル
# このファイルを .env にコピーして使用してください

# ==============================================================================
# デプロイスロット設定（環境判定）
# ==============================================================================
# development: ローカル開発環境（手動ログイン）
# staging: Azure App Service stagingスロット（Entra ID Easy Auth + staging DB）
# production: Azure App Service productionスロット（Entra ID Easy Auth + production DB）
DEPLOYMENT_SLOT=development

# ==============================================================================
# Flask設定
# ==============================================================================
SECRET_KEY=your-secret-key-here

# ==============================================================================
# Oracle DB接続設定（python-oracledb）
# スロット別に異なる接続先を設定する必要があります
# ==============================================================================

# 開発環境
ORACLE_DSN=localhost:1521/ORCL
ORACLE_USER=NAM_TASK
ORACLE_PASSWORD=your-password-here

# Staging環境（Azure App Serviceのスロット設定で上書き）
# ORACLE_DSN=staging-oracle-server:1521/STAGINGDB
# ORACLE_USER=NAM_TASK_STAGING
# ORACLE_PASSWORD=staging-password-here

# Production環境（Azure App Serviceのスロット設定で上書き）
# ORACLE_DSN=prod-oracle-server:1521/PRODDB
# ORACLE_USER=NAM_TASK
# ORACLE_PASSWORD=production-password-here

# ==============================================================================
# モックDB設定
# ==============================================================================
# モックDB使用フラグ（Oracle DBに接続できない場合はTrueに設定）
# True にするとモックデータでテストできます（Oracle DB不要）
USE_MOCK_DB=False

# Thick mode使用フラグ（通常はFalseでOK）
# Thin mode（デフォルト）: Oracle Instant Client不要
# Thick mode: Oracle Instant Clientが必要だが、高速
USE_THICK_MODE=False

# ==============================================================================
# アプリケーション設定
# ==============================================================================
ITEMS_PER_PAGE=20
MAX_UPLOAD_SIZE=10485760

# ==============================================================================
# ログ設定
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==============================================================================
# Azure App Service設定メモ
# ==============================================================================
# スロット固有設定（スワップされない設定）:
#   - DEPLOYMENT_SLOT
#   - ORACLE_DSN
#   - ORACLE_USER
#   - ORACLE_PASSWORD
#   - LOG_LEVEL (staging=INFO, production=WARNING)
#
# 共通設定（スワップされる設定）:
#   - SECRET_KEY
#   - ITEMS_PER_PAGE
#   - MAX_UPLOAD_SIZE
#   - その他アプリケーションロジックに関わる設定
